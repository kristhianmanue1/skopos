            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "glm-5.2": {
          "id": "glm-5.2",
          "name": "GLM 5.2",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "evidence_search": "allow",
    "evidence_fetch": "allow"
  }
}
